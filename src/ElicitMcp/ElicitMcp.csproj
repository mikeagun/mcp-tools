<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run on a newer major runtime when the targeted one is not installed. -->
    <RollForward>Major</RollForward>
    <AssemblyName>elicit-mcp</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>ElicitMcp</RootNamespace>
    <Description>Dual-purpose MCP elicitation server: agent-facing decision/input/feedback tools plus a form-mode conformance/showcase harness.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Mikeagun.McpTools.ElicitMcp</PackageId>
    <ToolCommandName>elicit-mcp</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- One framework-dependent package per runtime plus a platform-agnostic package that points at them. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64</ToolPackageRuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpSharp\McpSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElicitMcp.Tests" />
  </ItemGroup>

</Project>
