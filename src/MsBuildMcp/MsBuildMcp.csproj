<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Always run on the newest installed runtime: MSBuildLocator only registers .NET SDKs whose
         major version is not newer than the running runtime, so e.g. a machine with only the
         .NET 11 SDK needs this server on the .NET 11 runtime to evaluate projects. -->
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>msbuild-mcp</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>MsBuildMcp</RootNamespace>
    <Description>MCP server that gives LLM agents structured access to MSBuild solutions, projects, dependency graphs, and build execution.</Description>
    <!-- Microsoft.Build 17.x compile-time reference; actual MSBuild comes from MSBuildLocator at runtime -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Mikeagun.McpTools.MsBuildMcp</PackageId>
    <ToolCommandName>msbuild-mcp</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- One framework-dependent package per runtime plus a platform-agnostic package that points at them. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64</ToolPackageRuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsBuildMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpSharp\McpSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="17.12.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <!-- Required at runtime by VS MSBuild evaluation — ExcludeAssets on Microsoft.Build prevents transitive resolution -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.15" />
  </ItemGroup>

</Project>
