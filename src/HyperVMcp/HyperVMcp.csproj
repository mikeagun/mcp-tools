<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HyperVMcp</RootNamespace>
    <AssemblyName>hyperv-mcp</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyTitle>Hyper-V MCP Server</AssemblyTitle>
    <Product>Hyper-V MCP Server</Product>
    <Description>MCP server for Hyper-V virtual machine management</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run on a newer major runtime when the targeted one is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Mikeagun.McpTools.HyperVMcp</PackageId>
    <ToolCommandName>hyperv-mcp</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- One framework-dependent package per runtime plus a platform-agnostic package that points at them. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64</ToolPackageRuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperVMcp.Tests" />
    <!-- Hyper-V is Windows-only. A plain net10.0 TFM (rather than net10.0-windows) is used so the
         server can be packed as a .NET tool, so declare the platform for the CA1416 analyzer here. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpSharp\McpSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
  </ItemGroup>

</Project>
